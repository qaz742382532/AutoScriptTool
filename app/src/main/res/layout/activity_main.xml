<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 服务状态 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_service_off"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp" />

    <!-- 筛选设置卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 抢单筛选条件"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 最低金额 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="最低金额"
                android:textSize="14sp"
                android:textColor="#555555" />

            <EditText
                android:id="@+id/etMinAmount"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="例如 20"
                android:padding="12dp"
                android:background="@android:drawable/edit_text" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="元"
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center" />
        </LinearLayout>

        <!-- 最远接驾距离 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="接驾距离 ≤"
                android:textSize="14sp"
                android:textColor="#555555" />

            <EditText
                android:id="@+id/etMaxDistance"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="例如 5"
                android:padding="12dp"
                android:background="@android:drawable/edit_text" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="公里"
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center" />
        </LinearLayout>

        <!-- 屏蔽关键词 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚫 屏蔽关键词"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etBlockKeywords"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="text"
                android:hint="医院, 学校, 火车站, 机场"
                android:padding="12dp"
                android:background="@android:drawable/edit_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="起点或终点包含任一关键词则禁止抢单，用逗号/空格分隔"
                android:textSize="11sp"
                android:textColor="#999999"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 保存按钮 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="保存设置"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- 开启服务 -->
    <Button
        android:id="@+id/btnOpenScript"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="@string/btn_open_script"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_open_accessibility"
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_marginTop="16dp"
        android:gravity="center" />

</LinearLayout>
</ScrollView>